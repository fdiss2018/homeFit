PORT=3000

# JSON complet de la clé de compte de service Firebase (Console Firebase >
# Paramètres du projet > Comptes de service > Générer une nouvelle clé privée),
# collé sur une seule ligne. Ne jamais committer la vraie valeur.
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...", "...": "..."}

# Clé API Gemini (aistudio.google.com/apikey) — n'est plus jamais exposée au navigateur.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# Modèle Gemini utilisé pour la génération d'illustration d'exercice (image, pas texte/JSON) —
# variable distincte de GEMINI_MODEL car famille de modèle différente. Valeur de départ non
# vérifiée contre l'API réelle — voir "Churn des modèles" dans CLAUDE.md si erreur 404.
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# Bucket Firebase Storage (Console Firebase > Storage) où sont stockées les illustrations
# d'exercice. Doit correspondre au bucket de public/firebase-config.js.
FIREBASE_STORAGE_BUCKET=homefit-sh56.firebasestorage.app

# Secret long et aléatoire, généré une fois (ex. `openssl rand -hex 32`), utilisé
# pour tester l'API via Postman sans passer par un vrai login Firebase.
STATIC_API_TOKEN=

# Email autorisé à effectuer les opérations d'administration (bibliothèque
# d'exercices). Doit correspondre au compte utilisé pour se connecter côté front.
ADMIN_EMAIL=

# Origines autorisées en CORS, séparées par des virgules (ex. domaine Firebase
# Hosting + localhost de dev).
CORS_ALLOWED_ORIGIN=http://localhost:5000,https://homefit-sh56.web.app
